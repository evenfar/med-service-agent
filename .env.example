# LLM（OpenAI 兼容接口）。默认智谱 GLM；DeepSeek 换 https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4-flash
EMBEDDING_MODEL=embedding-2
TEMPERATURE=0.5

# 离线 mock 模式（=1 时不需要 Key，全链路本地假实现）；不配 Key 时也会自动进入
MOCK_MODE=0

# MCP（第4期）：=1 需另起 python mcp_server/server.py
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9301/mcp

# Multi-Agent（第6期）
MULTI_AGENT_ENABLED=false

# Memory（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skills（第8期）
SKILLS_ENABLED=true

# RAG（第5期）
RAG_BACKEND=local
# RAG_BACKEND=chroma  # 需 pip install chromadb

# 评估（第9期）
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6
